{
  "name": "yeshello.lol",
  "version": "1.0.0",
  "private": true,
  "description": "The Gen Z Communication Power Move - a humorous website exploring the 'Yes Hello' communication style",
  "scripts": {
    "start": "node scripts/static-server.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js && npm run lint:assets",
    "lint:html": "htmlhint \"*.html\"",
    "lint:css": "stylelint \"*.css\"",
    "lint:js": "eslint \"*.js\" \"scripts/**/*.mjs\"",
    "lint:assets": "node scripts/stamp-assets.mjs --check",
    "stamp": "node scripts/stamp-assets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manaiakalani/yeshello.lol.git"
  },
  "author": "Manaiakalani",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Manaiakalani/yeshello.lol/issues"
  },
  "homepage": "https://yeshello.lol",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "htmlhint": "^1.9.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
